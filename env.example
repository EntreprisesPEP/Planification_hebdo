# Copie ce fichier en .env.local (en local) et configure les memes valeurs
# comme variables d'environnement dans Vercel (Project Settings > Environment Variables).
#
# Trouve ces valeurs dans ton projet Supabase :
# Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Mot de passe pour passer en "mode animateur" (edition).
# PAS de prefixe NEXT_PUBLIC_ - reste cote serveur, jamais visible dans le navigateur.
# Si tu ne mets rien ici, n'importe qui peut passer en mode animateur (comme avant).
ANIMATEUR_PASSWORD=change-moi
